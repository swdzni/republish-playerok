# Обязательно: вся строка Cookie из авторизованного браузера Playerok.
PLAYEROK_COOKIES=ВСТАВЬТЕ_COOKIES_СЮДА

# Обычно можно оставить пустыми. Если Playerok начал проверять окружение,
# укажите User-Agent того же браузера и тот же прокси/IP, где брались cookies.
PLAYEROK_USER_AGENT=
PLAYEROK_PROXY=
